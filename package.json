{
  "name": "ourdao-backend",
  "version": "0.2.0",
  "private": true,
  "description": "OurDAO backend \u2014 off-chain indexer + read API for the Stellar/Soroban lending DAO.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "reindex": "tsx src/indexer/reindex.ts",
    "replay-failed": "tsx src/indexer/replay.ts",
    "reorg:clear": "tsx src/indexer/clear-reorg.ts",
    "bench:events": "tsx scripts/bench-events-storage.ts",
    "bench:api-latency": "tsx scripts/bench-api-latency.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "tsx scripts/generate-openapi-spec.ts",
    "openapi:validate": "npm run openapi:generate && git diff --exit-code openapi.json",
    "license:check": "tsx scripts/check-licenses.ts",
    "audit:schema-drift": "tsx scripts/audit-schema-drift.ts",
    "check:migrations": "tsx scripts/check-sequential-migrations.ts",
    "clean:test-schemas": "tsx scripts/clean-test-schemas.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.8.0",
    "license-checker": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
